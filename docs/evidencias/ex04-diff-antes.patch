@@ -0,0 +1,44 @@
+"""Validação do formato dos arquivos de turno (config/horarios-*.json)."""
+
+from __future__ import annotations
+
+from datetime import datetime, time
+
+CHAVES_OBRIGATORIAS = ("inicio", "fim", "duracao_consulta_min", "dias")
+
+
+def _hora(texto: object) -> time | None:
+    if not isinstance(texto, str):
+        return None
+    try:
+        return datetime.strptime(texto, "%H:%M").time()
+    except ValueError:
+        return None
+
+
+def validar_turno(dados: dict) -> list[str]:
+    erros: list[str] = []
+    for chave in CHAVES_OBRIGATORIAS:
+        if chave not in dados:
+            erros.append(f"Chave obrigatória ausente: {chave}")
+
+    inicio = fim = None
+    for chave in ("inicio", "fim"):
+        if chave not in dados:
+            continue
+        hora = _hora(dados[chave])
+        if hora is None:
+            erros.append(f"Horário inválido em '{chave}' (esperado HH:MM): {dados[chave]!r}")
+        elif chave == "inicio":
+            inicio = hora
+        else:
+            fim = hora
+    if inicio is not None and fim is not None and fim <= inicio:
+        erros.append("'fim' deve ser depois de 'inicio'")
+
+    if "duracao_consulta_min" in dados:
+        duracao = dados["duracao_consulta_min"]
+        if isinstance(duracao, bool) or not isinstance(duracao, int) or duracao <= 0:
+            erros.append(f"'duracao_consulta_min' deve ser um inteiro positivo: {duracao!r}")
+
+    return erros
