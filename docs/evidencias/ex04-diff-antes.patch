@@ -0,0 +1,45 @@
+"""Testes do validador de turnos (unittest, sem dependências externas)."""
+
+import json
+import unittest
+from pathlib import Path
+
+from agendamento.validacao_config import validar_turno
+
+RAIZ = Path(__file__).resolve().parents[2]
+TURNO_OK = {"inicio": "08:00", "fim": "17:00", "duracao_consulta_min": 30, "dias": [0, 1, 2]}
+
+
+class TestValidarTurno(unittest.TestCase):
+    def test_turno_valido(self):
+        self.assertEqual(validar_turno(TURNO_OK), [])
+
+    def test_chaves_ausentes(self):
+        erros = validar_turno({})
+        self.assertEqual(len(erros), 4)
+
+    def test_horario_invalido(self):
+        erros = validar_turno({**TURNO_OK, "inicio": "8h"})
+        self.assertEqual(len(erros), 1)
+        self.assertIn("inicio", erros[0])
+
+    def test_fim_antes_do_inicio(self):
+        self.assertEqual(len(validar_turno({**TURNO_OK, "inicio": "17:00", "fim": "08:00"})), 1)
+
+    def test_duracao_nao_positiva(self):
+        self.assertEqual(len(validar_turno({**TURNO_OK, "duracao_consulta_min": 0})), 1)
+        self.assertEqual(len(validar_turno({**TURNO_OK, "duracao_consulta_min": "30"})), 1)
+
+
+class TestConfigReal(unittest.TestCase):
+    def test_arquivos_de_config_sem_erros(self):
+        arquivos = sorted((RAIZ / "config").glob("horarios-*.json"))
+        self.assertTrue(arquivos, "nenhum config/horarios-*.json encontrado")
+        for arquivo in arquivos:
+            with self.subTest(arquivo=arquivo.name):
+                dados = json.loads(arquivo.read_text(encoding="utf-8"))
+                self.assertEqual(validar_turno(dados), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
